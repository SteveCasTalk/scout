# Copy to .env and fill locally. Never send these values in chat or commit .env.
JEV_TEST_EMAIL=
JEV_TEST_PASSWORD=
# TypeSafe's Jev model is used for operation and element selection.
TYPESAFE_API_KEY=
# Standalone runner only: generated text for non-credential fields. MCP runs ask the host via enter_text.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://api.deepseek.com/v1
TEXT_MODEL=deepseek-chat

# Optional path to the Android Debug Bridge executable.
ADB_PATH=

# Dashboard origin used in links returned by prompt-driven MCP runs.
JEV_DASHBOARD_URL=http://localhost:5173
